{
  "name": "quadrant-todo-app",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"npm run dev:client\" \"npm run start:server\"",
    "dev:client": "cd client && npm run dev",
    "start:server": "cd server && npm start",
    "start:electron": "concurrently \"npm run start:server\" \"wait-on http://localhost:3000 && electron .\"",
    "build": "cd client && npm run build",
    "package": "electron-builder",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "format": "prettier --write .",
    "prepare": "husky install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^29.1.5",
    "electron-builder": "24.6.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "wait-on": "^7.0.1"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^7.2.0",
    "@mui/material": "^7.2.0",
    "@mui/x-date-pickers": "^7.2.0",
    "cors": "^2.8.5",
    "dayjs": "^1.11.13",
    "electron-is-dev": "^2.0.0",
    "express": "^5.1.0",
    "lodash": "^4.17.21",
    "lowdb": "^1.0.0",
    "uuid": "^11.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
